; PROCEDURES


ParseTempsFromString2 PROC
	; [EBP + 12] = OFFSET fileBuffer			; file, reads from this
	; [EBP + 8] = OFFSET tempArray				; array to store
	PUSH	EBP
	MOV		EBP, ESP

	MOV		ESI, [EBP + 12]						; string
	MOV		EDX, [EBP + 12]
	MOV		EDI, [EBP + 8]						; new temp array
	MOV		ECX, TEMPS_PER_DAY					; how many values in the temp array
	CLD

 _next:
	PUSH	EDI									; EDI will be inc with LODSB so we need to save original mem addy for storing the actual values

 _readInput:	
	LODSB
	CMP		AL, DELIMITER						; if the char is the delimiter, we've reached the end of the integer/temp
	JE		_skip
	STOSB										; if not at end of temperature int, store value (it's over 9)
	JMP		_readInput							; in the case of numbers that are more than 1 length ie 12 (2 length)
	
 _skip:
	; when it's the delimiter, ie ',' we want to skip adding this to the array and move on to the next value
	;MOV		[EDI], BYTE PTR 0					; null terminate string
	STOSB										; store the Delimiter into array
	JMP		_getNumericalValue

_nextNum:
	MOV		EDX, ESI							; save where we left off in reading the array
	POP		EDI									; restore original memory address of tempArray
	MOV		[EDI], EAX
	call	writeint
	ADD		EDI, 4								; go to next memory location 
	LOOP	_next
	CMP		ECX, 0								; after exiting loop, skip to end of procedure
	JE		_exitProc

 _getNumericalValue:
	PUSH	ESI									; will need to store value
	PUSH	ECX									; save original loop counter
	XOR		EAX, EAX
	MOV		ESI, EDX							; put stored string into ESI
	MOV		EBX, 10								; mul by 10 to convert to decimal integer
	MOV		ECX, 0								; "accumulator"
	MOV		negative, ECX						; re-initialize negative flag
	LODSB
	

 _parseString:
	CMP		AL, "-"								; see if first char is a neg sign
	JNE		_positive
	; if = "-" then it's a negative number. Will need to turn it negative after the rest of the number is parsed
	MOV		negative, 1							; sign that it will be negated later
 _nextChar:	
	LODSB
	;JMP		_parseString

 _positive:										
	CMP		AL, DELIMITER						; 0 = null termination, NOT a string '0'
	JE		_checkNegative
	SUB		AL, 48
	PUSH	EAX									; save the loaded string for later
	MOV		EAX, ECX
	PUSH	EDX									; save EDX
	MUL		EBX									; this is how to get 10, 100, 1000, etc
	POP		EDX									; restore EDX (due to mul)
	MOV		ECX, EAX
	POP		EAX									; restore the loaded string
	ADD		ECX, EAX
	JMP		_nextChar

 _checkNegative:
	CMP		negative, 1
	JNE		_done
	NEG		ECX									; if 1 is set, then it's negative

 _done:
 	MOV		EAX, ECX							
	POP		ECX									; restore original loop counter
	POP		ESI									; restore string array
	JMP		_nextNum


_exitProc:
	POP		EBP
	RET 8
ParseTempsFromString2 ENDP




; [EBP + 28] = OFFSET error_reading
; [EBP + 24] = OFFSET fileBuffer
; [EBP + 20] = OFFSET fileHandle
