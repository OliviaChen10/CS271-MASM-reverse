; MACROS

; -------------------------------
; Macro to
; arg1 = str address        arg2 = readstring input	
; -------------------------------
mGetString MACRO prompt, input
	PUSH	EDX
	MOV		EDX, prompt										; "please enter..."
	CALL	WriteString
	MOV		EDX, input										; input will be filename/file
	MOV		ECX, 50											; size can accomodate
	CALL	ReadString



	; input: user's keyboard input into a memory location (output, reference)

	; count: input, value for length of string you can accomodate

	POP		EDX
ENDM

; -------------------------------
; Macro to print a string
; arg1 = str address
; -------------------------------
mDisplayString MACRO str_input
	PUSH	EDX
	MOV		EDX, str_input
	CALL	WriteString

	POP		EDX
ENDM


; -------------------------------
; Macro to print an ASCII formatted character that is provided as an immediate or constant
; -------------------------------
mDisplayChar MACRO ascii_num
	PUSH	EAX
	MOV		EAX, ascii_num
	CALL	WriteChar

	POP		EAX
ENDM

