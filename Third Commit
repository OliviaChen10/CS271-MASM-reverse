ParseTempsFromString2 PROC
	; [EBP + 12] = OFFSET fileBuffer			; file, reads from this
	; [EBP + 8] = OFFSET tempArray				; array to store
	; [EBP + 4] = RET
	; [EBP] = Old EBP

	PUSH	EBP
	MOV		EBP, ESP
	PUSH	ESI

	MOV		ESI, [EBP + 12]						; file memory address

	MOV		EDI, [EBP + 8]						; destination array
	MOV		ECX, TEMPS_PER_DAY					; loop counter

	CLD											; clear direction flag

 _parseFile:
	LODSB
	CMP		AL, DELIMITER
	JE		_skip
	STOSB

 _skip:
	; delimiter, do not store in array

	JMP		_parseFile


	POP     ESI
	POP		EBP
	RET		
ParseTempsFromString2 ENDP









; PROCEDURES

; [EBP + 32] = length lenFileBuffer
; [EBP + 28] = OFFSET error_reading
; [EBP + 24] = OFFSET fileBuffer 
; [EBP + 20] = OFFSET fileHandle
; [EBP + 16] = OFFSET error_filename
; [EBP + 12] = OFFSET user_input
; [EBP + 8] = OFFSET tempArray
; [EBP + 4] = RET
; [EBP] = Old EBP
ParseTempsFromString PROC
	PUSH	EBP
	MOV		EBP, ESP
	PUSH	EDX

	MOV		EDX, [EBP + 12]										; move filename into EDX
	CALL	OpenInputFile
	MOV		[EBP + 20], EAX										; mov eax into filehandle

	CMP		EAX, INVALID_HANDLE_VALUE
	JNE		_validName
	mDisplayString [EBP + 16]									; call write string macro with error message
	JMP		_quit


 _validName:
	MOV		EAX, [EBP + 20]										; filehandle into EAX
	MOV		EDX, [EBP + 24]										; OFFSET fileBuffer into EDX
	MOV		ECX, [EBP + 32]
	CALL	ReadFromFile
	MOV		bytesRead, EAX
	JNC		_validRead											; when no error in reading file
	mDisplayString [EBP + 28]									; call write string macro with error message
	JMP		_quit

 _validRead:
	;MOV		fileSize, EAX
	;MOV		EAX, fileHandle
	CALL	CloseFile


; PARSE FROM FILE

	


 _quit: 
	POP		EDX
	POP		EBP
	RET		28
ParseTempsFromString ENDP



; ------ WRITETEMPSREVERSE ------
; Procedure to write out an array in reverse
; Preconditions: 
	; [EBP + 16] = array
	; [EBP + 12] = LENGTHOF array (5)
	; [EBP + 8] = TYPE array (SDWORD = 4)
	; [EBP + 4] = RET
	; [EBP] = Old EBP
; Postconditions: Modifies ESI, ECX, EBX, EAX

WriteTempsReverse PROC

	PUSH	EBP
	MOV		EBP, ESP
	PUSH	ESI													; save registers
	PUSH	ECX
	PUSH	EBX
	PUSH	EAX

	MOV		EAX, [EBP + 8]										; TYPE array (SDWORD = 4)
	MOV		EBX, [EBP + 12]										; LENGTHOF array 
	DEC		EBX
	MUL		EAX
	MOV		ESI, [EBP + 16]										; put address of array into ESI
	ADD		ESI, EAX											; type * lengthof - 1 = last element of array
	MOV		ECX, [EBP + 12]										; # elements of array = loop counter

 _printRev:
	MOV		EAX, [ESI]
	CALL	WriteInt											; print signed (int not dec)
	mDisplayChar DELIMITER
	SUB		ESI, [EBP + 8]										; move backwards by array type (4)
	LOOP	_printRev

	POP		EAX													; restore registers
	POP		EBX
	POP		ECX
	POP		ESI
	POP		EBP
	RET		12
WriteTempsReverse ENDP





